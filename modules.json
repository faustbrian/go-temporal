      "kind": "public library",
      "releasable": true,
      "family": "domain-utilities",
      "family_label": "Domain Utilities",
      "family_description": "Domain-specific immutable values, algorithms, parsers, proofs, and calculations.",
      "family_order": 8,
      "cohesion": {
        "family": "domain-utilities",
        "secondary_capabilities": [
          "configuration",
          "data-encoding",
          "database-and-storage",
          "protocols-and-schemas"
        ],
        "responsibility": "Provide immutable temporal algebra, explicit interval bounds and relations, normalized sets, fixed durations, daily intervals, strict notation, and versioned encodings.",
        "non_goals": [
          "Own scheduling, workflow orchestration, clocks, timers, or timezone databases.",
          "Provide chart rendering or claim complete compatibility with the source PHP package while charting remains deferred.",
          "Treat calendar months or years as fixed elapsed durations."
        ],
        "public_package_identifier": "temporal",
        "primary_entry_packages": [
          "github.com/faustbrian/go-temporal"
        ],
        "package_selection": {
          "github.com/faustbrian/go-temporal": "Use for interval bounds, Allen relations, typed errors, and explicit resource limits.",
          "github.com/faustbrian/go-temporal/dateperiod": "Use for immutable bounded civil-date periods, calendar-based factories, and normalized date sets.",
          "github.com/faustbrian/go-temporal/instant": "Use for immutable bounded time.Time periods, elapsed-time operations, and normalized instant sets.",
          "github.com/faustbrian/go-temporal/notation": "Use for strict ISO 8601, ISO 80000, and Bourbaki parsing and formatting.",
          "github.com/faustbrian/go-temporal/postgres": "Use for loss-checked database/sql and pgx range or multirange mapping without connection ownership.",
          "github.com/faustbrian/go-temporal/temporalconfig": "Use for go-config-compatible text wrappers around temporal values.",
          "github.com/faustbrian/go-temporal/temporaltest": "Use in tests for exhaustive relation fixtures and temporal set assertions.",
          "github.com/faustbrian/go-temporal/temporalvalidation": "Use for go-validation-compatible rules over temporal values.",
          "github.com/faustbrian/go-temporal/temporalwire": "Use for versioned format-neutral scalar and collection documents.",
          "github.com/faustbrian/go-temporal/timeofday": "Use for immutable local times, fixed durations, circular daily intervals, and normalized daily sets."
